# Next.js / Vercel runtime
# Use the URL from the same Convex deployment that receives the backend deploy.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk application keys. Use matching test keys locally and live keys in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Clerk routes used by middleware and the onboarding flow.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Convex deployment only — do not expose these to the browser or Vercel client.
# Set CLERK_FRONTEND_API_URL to the issuer/domain shown by Clerk's Convex
# integration. The legacy CLERK_JWT_ISSUER_DOMAIN name remains supported.
# CLERK_FRONTEND_API_URL=https://your-clerk-domain.clerk.accounts.dev
#
# Generate once with: openssl rand -base64 32
# Rotating this key requires a credential migration; existing connector tokens
# cannot be decrypted with a replacement key.
# CONNECTOR_ENCRYPTION_KEY=replace_me_with_a_generated_secret

# Connector credential ownership
# - GitHub OAuth is provided by the user's linked Clerk GitHub account.
# - Devin organization tokens are entered per account and encrypted in Convex.
# There are no shared GITHUB_TOKEN or DEVIN_API_KEY deployment variables.
