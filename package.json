{
  "name": "proper-respect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/deployment-preflight.test.mjs scripts/replay-evidence.test.mjs",
    "test:watch": "vitest",
    "evidence:replay": "node --experimental-strip-types scripts/replay-evidence.mjs",
    "test:e2e": "playwright test",
    "deploy:check": "node scripts/deployment-preflight.mjs",
    "deploy:check:strict": "node scripts/deployment-preflight.mjs --strict",
    "convex:dev": "convex dev",
    "convex:seed": "convex run seed:seedKeegan",
    "convex:seed:prod": "convex run seed:seedKeegan --prod"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.1",
    "@noble/hashes": "2.4.0",
    "cheerio": "1.2.0",
    "convex": "^1.42.3",
    "next": "^16.3.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "convex-test": "^0.0.58",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
